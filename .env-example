# Orchestrator GitHub API (fetch terraplane.yaml, PR head SHA, comments, reviews, checks).
# Either a personal access token ...
ORCHESTRATOR_GITHUB_ACCESS_TOKEN=
# ... or a GitHub App (leave the token empty). The private key is the PEM GitHub issues,
# inline or as a file path. The installation ID is optional: without it the orchestrator
# looks up the installation for each repository's organisation or user.
# ORCHESTRATOR_GITHUB_APP_ID=
# ORCHESTRATOR_GITHUB_APP_PRIVATE_KEY_PATH=/path/to/app.pem
# ORCHESTRATOR_GITHUB_APP_INSTALLATION_ID=
ORCHESTRATOR_GITHUB_WEBHOOK_SECRET=

# Orchestrator database (postgres or mysql)
DATABASE_DRIVER=postgres
DATABASE_URL=postgres://terraplane:terraplane@postgres:5432/terraplane?sslmode=disable

# Agent tool defaults: terraform or tofu, and the version used when a stack sets none
# AGENT_DEFAULT_TOOL=terraform
# AGENT_DEFAULT_TERRAFORM_VERSION=1.15.6
# AGENT_DEFAULT_TOFU_VERSION=1.11.5

# Agent deploy key — host path (docker-compose bind-mounts into the container)
AGENT_SCM_SSH_KEY_PATH=/path/to/deploy_key

SHARED_AUTH_TOKEN=shared_secret

# Multi-team mode (per-agent tokens, routing, permissions, apply gates). See docs/multi-team.md
# ORCHESTRATOR_CONFIG_PATH=./orchestrator.yaml
# ORCHESTRATOR_TEAM_CACHE_TTL=5m

# Orchestrator job retention (terminal jobs older than this are deleted)
ORCHESTRATOR_JOB_CLEANUP_INTERVAL=720h
# How often to run job cleanup (claim reaping uses ORCHESTRATOR_DISPATCHER_JOB_POLL_INTERVAL)
ORCHESTRATOR_JOB_CLEANUP_POLL_INTERVAL=1h
